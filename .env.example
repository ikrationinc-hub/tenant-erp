# --- General ---
# NODE_ENV is deliberately NOT set here: apps/api/apps/worker default to
# "development" on their own (config/env.ts), and Vite's envDir now points
# at this file too - an explicit NODE_ENV here would leak into the
# frontend build and disable production minification/dead-code-elimination
# for apps/web and apps/admin.
PORT=3000
LOG_LEVEL=info

# --- Database (Postgres, apps/api) ---
# Host port is 5433, not the Postgres default 5432 (see docker/docker-compose.yml) -
DATABASE_URL=postgres://hyperion:hyperion@localhost:5433/hyperion
# Restricted, non-superuser role - migrations create/grant it automatically (core/database/migration-runner.ts).
DATABASE_APP_URL=postgres://hyperion_app:change-me@localhost:5433/hyperion

# --- Redis (apps/api + apps/worker) ---
# Host port is 6380, not the Redis default 6379, for the same reason.
REDIS_URL=redis://localhost:6380

# --- Auth (apps/api) ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-hex-string
PLATFORM_JWT_SECRET=change-me-to-yet-another-random-64-char-hex-string

# --- Storage: MinIO (S3 API, apps/api) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hyperion
S3_SECRET_ACCESS_KEY=hyperion123
S3_BUCKET=hyperion-erp

# --- Virus scanning: ClamAV (docker/docker-compose.yml's clamav service, apps/api) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Email: Resend (apps/api) ---
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Ikration ERP

# --- Web app base URL (apps/web dev server, used to build links in emails) ---
WEB_APP_BASE_URL=http://localhost:5173

# --- Frontend (apps/web, apps/admin - Vite envDir points at repo root) ---
# Base URL of apps/api. Only used when VITE_USE_MOCKS is not "true".
VITE_WEB_API_BASE_URL=http://localhost:3000/api/v1
# Base URL of apps/api's platform-admin route group. Only used when VITE_USE_MOCKS is not "true".
VITE_ADMIN_API_BASE_URL=http://localhost:3000/api/v1/platform
# "true" -> MSW intercepts every request, the app runs with zero backend.
# "false" -> requests go to the *_API_BASE_URL above.
VITE_USE_MOCKS=false
